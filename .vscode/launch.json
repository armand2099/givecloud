{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug current Playwright test",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "playwright",
        "test",
        "tests/${fileBasename}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}